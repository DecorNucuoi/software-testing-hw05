          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HDR-AUTH-USER" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-CHECKOUT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// orderId la kiem tra NGU NGHIA THAT duy nhat cua nhanh transactional phia user:
// no xac nhan INSERT vao bang orders da tra ve lastID.
// LUU Y: KHONG assert gia tri total_amount da ghi. SUT ghi thang so tien do
// client gui, va voi ma percent thi con so do sai co chu y (500000 -> 5000000).
// Viec do kiem bang cong SQL sau run, khong kiem trong test plan.
String tok = vars.get("TOKEN")
if (tok == null || tok.isEmpty() || tok.equals("NOT_FOUND")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("TOKEN rong hoac NOT_FOUND -- nguyen nhan goc nam o LOGIN_MAIN")
    return
}

String body = SampleResult.getResponseDataAsString()
def j = null
try {
    j = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong parse duoc JSON: " + e.getMessage() + " | body=" + body.take(200))
    return
}

if (!(j.orderId instanceof Number) || ((Number) j.orderId).longValue() &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("orderId khong hop le: " + j.orderId + " -- INSERT vao bang orders co the da that bai")
}</stringProp>
          </JSR223Assertion>
