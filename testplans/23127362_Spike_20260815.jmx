            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-ADMIN-DELETE (gioi han da biet)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">/*
 GIOI HAN DA BIET - xac minh bang thuc nghiem tren SUT:
   DELETE /api/products/9999 voi id KHONG TON TAI van tra
   HTTP 200 {"message":"Product deleted"}
 vi ma nguon khong kiem tra this.changes.

 Hau qua truc tiep: sampler nay KHONG THE tu chung minh rang no da don dep
 thanh cong. Bat bien "products = 5 dong" duoc bao dam boi HAI lop khac:
   (1) assertion expect_count cua SEARCH / ADMIN_SEARCH trong suot run
   (2) cong SQL sau run: SELECT COUNT(*) FROM products phai bang 5
 va mot luoi an toan cuoi cung la tearDown Thread Group.
*/
String body = SampleResult.getResponseDataAsString()
if (!body.contains("Product deleted")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("body khong chua chuoi 'Product deleted': " + body.take(200))
}</stringProp>
