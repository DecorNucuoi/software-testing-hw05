          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="THINK 1s (nghi cuoi vong truoc)" enabled="true">
            <stringProp name="ConstantTimer.delay">800</stringProp>
            <stringProp name="RandomTimer.range">400.0</stringProp>
          </UniformRandomTimer>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="EXT-LOGIN-ADMIN" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">ADMIN_TOKEN;ADMIN_USER_ID</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.token;$.user.id</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-LOGIN" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">ADMIN_TOKEN ADMIN_USER_ID</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String tokVar = args[0]
String uidVar = args[1]
int code = -1
try { code = SampleResult.getResponseCode().toInteger() } catch (Exception ignored) { }

if (code == 401) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("401 - tai khoan admin khong ton tai. Server co duoc restart va seed lai khong?")
    return
}
if (code == 403) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("403 - tai khoan admin bi khoa 180s. Ca 3 thread cua TG-3 dung chung admin@eshop.com nen mot lan login sai se lam chet ca nhanh admin.")
    return
}
if (code != 200) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("HTTP " + code + " (mong doi 200)")
    return
}
String tok = vars.get(tokVar)
if (tok == null || tok.isEmpty() || tok.equals("NOT_FOUND")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("HTTP 200 nhung khong trich duoc token admin.")
    return
}
String uid = vars.get(uidVar)
if (uid == null || !uid.isInteger() || uid.toInteger() &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("user.id khong hop le: " + uid)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

