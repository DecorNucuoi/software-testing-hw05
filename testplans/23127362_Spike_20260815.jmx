            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String tokVar = args[0]
String uidVar = args[1]
int code = -1
try { code = SampleResult.getResponseCode().toInteger() } catch (Exception ignored) { }

if (code == 401) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("401 - tai khoan khong ton tai tren SUT. Kiem tra TG_OFFSET va kich thuoc khoi provisioning (MAIN 1..220, AUTH 1001..1080).")
    return
}
if (code == 403) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("403 - tai khoan bi khoa 180s. Hai thread dang dung chung mot tai khoan, hoac da co login sai truoc do.")
    return
}
if (code != 200) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("HTTP " + code + " (mong doi 200)")
    return
}
String tok = vars.get(tokVar)
if (tok == null || tok.isEmpty() || tok.equals("NOT_FOUND")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("HTTP 200 nhung khong trich duoc token. Moi sampler can auth phia sau se hong theo - nguyen nhan goc nam o day.")
    return
}
String uid = vars.get(uidVar)
if (uid == null || !uid.isInteger() || uid.toInteger() &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("user.id khong hop le: " + uid)
}</stringProp>
          </JSR223Assertion>
