        <hashTree>
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="THINK 500ms" enabled="true">
            <stringProp name="ConstantTimer.delay">400</stringProp>
            <stringProp name="RandomTimer.range">200.0</stringProp>
          </UniformRandomTimer>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-DETAIL" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">NEW_PID</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String wantId = vars.get(args[0])
String body = SampleResult.getResponseDataAsString()

def j = null
try {
    j = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong parse duoc JSON: " + e.getMessage() + " | body=" + body.take(200))
    return
}

if (!(j instanceof Map) || j.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("BAY 200-BODY-RONG: san pham vua tao id=" + wantId + " doc lai ra body rong {}. CREATE co the da khong ghi that su.")
    return
}
if (j.id == null || !(j.id.toString().equals(wantId))) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("id tra ve=" + j.id + " khac id da yeu cau=" + wantId)
    return
}
if (j.name == null || j.name.toString().trim().isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("thieu truong name")
    return
}
if (!(j.price instanceof Number) || ((Number) j.price).doubleValue() &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("price khong hop le: " + j.price)
}</stringProp>
          </JSR223Assertion>
