          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-ADMIN-CREATE" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String body = SampleResult.getResponseDataAsString()
def j = null
try {
    j = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong parse duoc JSON: " + e.getMessage() + " | body=" + body.take(200))
    return
}

if (!(j.id instanceof Number)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong co truong id kieu so trong response: " + body.take(200))
    return
}

long newId = ((Number) j.id).longValue()
if (newId &lt;= 5) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("CHOT CHAN AN TOAN: id=" + newId + " nam trong dai seed 1..5. Neu PUT/DELETE chay tiep se pha huy mot san pham seed va lam hong bat bien 'products = 5 dong' cho toan bo run.")
}</stringProp>
