          </UniformRandomTimer>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="EXT-COUPON" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">FINAL_AMOUNT</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.final_amount</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PP-COUPON-FALLBACK" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 4/10 dong trong coupons.csv la nhanh tu choi hop le (BELOW_MIN, EXPIRED,
// INVALID). Nhung dong do khong co final_amount, nen FINAL_AMOUNT se la
// NOT_FOUND va CHECKOUT se gui JSON hong -> loi gia.
// Hanh vi thuc te cua nguoi dung khi ma giam gia bi tu choi: van thanh toan
// voi so tien goc. Day chinh la ung xu duoc cai dat o day.
String fa = vars.get("FINAL_AMOUNT")
if (fa == null || !fa.isNumber()) {
    vars.put("FINAL_AMOUNT", vars.get("total_amount"))
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-RESET_STATUS (Ignore Status)" enabled="true">
            <collectionProp name="Asserion.test_strings"/>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-COUPON-BUSINESS" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// Phan tu RA-RESET_STATUS o TREN da xoa co fail do 4xx (400 cho BELOW_MIN va
// EXPIRED, 404 cho INVALID). Nhung no xoa voi MOI ma, ke ca 500. Vi vay viec
// kiem tra ma HTTP tuong minh o day la BAT BUOC - no bu lai dung cai ma lop
// tren vua vo hieu hoa.
String body = SampleResult.getResponseDataAsString()
int code = -1
try { code = SampleResult.getResponseCode().toInteger() } catch (Exception ignored) { }

int wantHttp = -1
try {
    wantHttp = vars.get("expect_http").toInteger()
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("expect_http khong doc duoc tu CSV: " + vars.get("expect_http"))
    return
}
boolean wantOk = "true".equals(vars.get("expect_success"))

List problems = []
if (code != wantHttp) { problems.add("http=" + code + " (mong doi " + wantHttp + ")") }

try {
    def j = new JsonSlurper().parseText(body)
    if (wantOk) {
        if (j.success != true) { problems.add("success=" + j.success) }
        BigDecimal want = new BigDecimal(vars.get("expect_final_amount"))
        BigDecimal got = (j.final_amount == null) ? null : new BigDecimal(j.final_amount.toString())
        if (got == null || got.compareTo(want) != 0) {
            problems.add("final_amount=" + got + " (mong doi " + want + ")")
        }
    } else {
        if (j.success == true) { problems.add("success=true nhung dong CSV mong doi bi tu choi") }
        if (j.error == null) { problems.add("thieu truong error") }
    }
} catch (Exception e) {
    problems.add("khong parse duoc JSON: " + e.getMessage())
}

if (!problems.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("code=" + vars.get("code")
        + " total=" + vars.get("total_amount")
        + " class=" + vars.get("case_class")
        + " :: " + problems.join(" | ")
        + " :: body=" + body.take(200))
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

