          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="EXT-DETAIL-A" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">PRICE_A;NAME_A</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.price;$.name</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1;1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND</stringProp>
            <boolProp name="JSONPostProcessor.compute_concat">false</boolProp>
          </JSONPostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-DETAIL" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">pid_a</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String wantId = vars.get(args[0])
String body = SampleResult.getResponseDataAsString()

def j = null
try {
    j = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong parse duoc JSON: " + e.getMessage() + " | body=" + body.take(200))
    return
}

if (!(j instanceof Map) || j.isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("BAY 200-BODY-RONG: id=" + wantId + " tra HTTP 200 kem body rong {}. Ma trang thai HTTP KHONG phat hien duoc loi nay.")
    return
}
if (j.id == null || !(j.id.toString().equals(wantId))) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("id tra ve=" + j.id + " khac id da yeu cau=" + wantId)
    return
}
if (j.name == null || j.name.toString().trim().isEmpty()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("thieu truong name")
    return
}
if (!(j.price instanceof Number) || ((Number) j.price).doubleValue() &lt;= 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("price khong hop le: " + j.price)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

        <!-- == Buoc 4: DETAIL_B  (read-heavy, FR-06) == -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DETAIL_B" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/api/products/${pid_b}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
