          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="RA-CODE-200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-SEARCH-COUNT" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

String body = SampleResult.getResponseDataAsString()
int want = 0
try {
    want = vars.get("expect_count").toInteger()
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("expect_count khong doc duoc tu CSV: " + vars.get("expect_count"))
    return
}

def arr = null
try {
    arr = new JsonSlurper().parseText(body)
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("khong parse duoc JSON: " + e.getMessage() + " | body=" + body.take(200))
    return
}

if (!(arr instanceof List)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("response khong phai mang tran nhu mong doi")
    return
}

if (arr.size() != want) {
    String hint = ""
    if (arr.size() &gt; want) { hint = " -- nghi ngo san pham LTPERF cua nhanh admin chua duoc DELETE" }
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("keyword='" + vars.get("keyword") + "' tra ve " + arr.size() + " ket qua, mong doi " + want + hint)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

        <!-- == Buoc 3: DETAIL_A  (read-heavy, FR-06) == -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="DETAIL_A" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
