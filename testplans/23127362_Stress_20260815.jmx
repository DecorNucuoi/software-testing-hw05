            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Body cua SUT la chuoi co dinh {"message":"Added to cart"} - khong co noi dung
// ngu nghia nao de kiem tra. Gia tri that cua assertion nay nam o cho khac:
// no chi ra rang neu CART hong thi nguyen nhan goc thuong o LOGIN_MAIN.
String tok = vars.get("TOKEN")
if (tok == null || tok.isEmpty() || tok.equals("NOT_FOUND")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("TOKEN rong hoac NOT_FOUND -- nguyen nhan goc nam o LOGIN_MAIN, khong phai o CART")
    return
}
String body = SampleResult.getResponseDataAsString()
if (!body.contains("Added to cart")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("body khong chua chuoi 'Added to cart': " + body.take(200))
}</stringProp>
