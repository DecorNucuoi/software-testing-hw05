        <!-- == Buoc 1: LOGIN_MAIN  (auth-heavy) == -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="LOGIN_MAIN" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
