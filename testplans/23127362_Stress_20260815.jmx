              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR-ADMIN-UPDATE (gioi han da biet)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">/*
 GIOI HAN DA BIET - xac minh bang thuc nghiem tren SUT:
   PUT /api/products/9999 voi id KHONG TON TAI van tra
   HTTP 200 {"message":"Product updated"}
 vi ma nguon khong kiem tra this.changes.

 Assertion nay VI VAY chi con hai gia tri:
   - bat HTTP 500
   - bat body sai dinh dang
 No KHONG THE xac nhan rang ban ghi da thuc su duoc cap nhat.

 Viec bao ve bat bien "products = 5 dong" chi con HAI lop that su:
   (1) assertion expect_count cua SEARCH / ADMIN_SEARCH, chay lien tuc trong run
   (2) cong SQL sau run: SELECT COUNT(*) FROM products phai bang 5
 If Controller boc ngoai la lop PHONG NGUA, khong phai lop xac minh.
*/
String body = SampleResult.getResponseDataAsString()
if (!body.contains("Product updated")) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("body khong chua chuoi 'Product updated': " + body.take(200))
}</stringProp>
            </JSR223Assertion>
